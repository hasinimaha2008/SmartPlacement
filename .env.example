# ============================================================================
# SmartPlacement Environment Configuration Example
# ============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="SmartPlacement API"

# Backend Database Configuration
# Direct PostgreSQL / Supabase connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Local fallback (used if no remote PostgreSQL is provided):
DATABASE_URL=sqlite:///./smartplacement.db

# Optional Supabase REST / Storage Credentials
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
